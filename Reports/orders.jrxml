	<queryString language="SQL">
		<![CDATA[SELECT
    `orders`.`order_id`,
    `orders`.`order`,
    `users`.`username`,
    `orders`.`price`,
    `orders`.`full_price`
FROM
    `orders`,
    `users`
WHERE
    `orders`.`user_id` = `users`.`id`
ORDER BY
    `orders`.`id`
DESC
LIMIT 1]]>
	</queryString>
