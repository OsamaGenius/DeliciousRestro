	<queryString language="SQL">
		<![CDATA[SELECT
    `orders`.`id`,
    `orders`.`order_id`,
    `users`.`username`,
    `orders`.`full_price`
FROM
    `orders`,
    `users`
WHERE
    `orders`.`user_id` = `users`.`id`
ORDER BY
    `orders`.`id`
DESC
LIMIT 1]]>
	</queryString>
