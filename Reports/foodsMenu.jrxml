	<queryString language="SQL">
		<![CDATA[SELECT
	`foods`.`image`,
    `foods`.`name`,
    `cates`.`category`,
    `foods`.`price`
FROM
    `foods`,
    `cates`
WHERE
    `foods`.`cate_id` = `cates`.`id`
GROUP BY
    `foods`.`id`
ORDER BY
    `cates`.`category`
DESC]]>
	</queryString>
